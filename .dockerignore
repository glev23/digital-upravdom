# Allowlist-стиль: исключено всё, кроме необходимого для сборки образа.
*

# Исходный код приложения
!src/
!src/**

# Миграции Alembic и конфигурация БД
!db/
!db/**

# Скрипты старта и обслуживания: миграции, сидирование справочников,
# загрузка предпосчитанных векторов в Qdrant (architecture.md §12 —
# «запуск одной командой»), переиндексация, проверка точности.
!scripts/
!scripts/**

# Публичные сертификаты Russian Trusted CA (Минцифры) — не секреты,
# нужны в build-контексте для доверия platform-api2.max.ru (max_api.md).
!docker/certs/
!docker/certs/**

# data/model/ НЕ разрешён: модель эмбеддингов не хранится в репозитории
# (490 МБ, лимит GitHub 100 МБ/файл) — экспортируется внутри сборки образа
# стейджем exporter (docker/app.Dockerfile), а не берётся из build-контекста.

# Предпосчитанные векторы базы знаний и справочники, загружаемые при старте.
!data/kb/
!data/kb/**
!data/seed/
!data/seed/**
!data/masking/
!data/masking/**
# Прототипы деградации без LLM (CLASSIFY-002): app.Dockerfile копирует
# data/classifier — без этой строки сборка падает на COPY (урок DATA-001).
!data/classifier/
!data/classifier/**
!data/test_cases/
!data/test_cases/**

# Зависимости и метаданные проекта
!pyproject.toml
!uv.lock
!README.md

# Явные исключения внутри разрешённых путей
__pycache__/
*.py[cod]
data/private/
