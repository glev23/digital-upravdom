# ============================================================================
# Цифровой Управдом — шаблон переменных окружения.
# Копируется в .env и заполняется реальными значениями.
# Рабочие токены, пароли и ключи в репозиторий не попадают.
#   cp .env.example .env
# ============================================================================

# --- MAX Bot API -----------------------------------------------------------
# Токен бота выдаётся организаторами хакатона.
MAX_BOT_TOKEN=
# Секрет для проверки подлинности входящего вебхука (architecture.md §7).
# Без него заявки может создавать любой, кто узнал URL вебхука.
MAX_WEBHOOK_SECRET=
# Ник бота — нужен для сборки deep-link на привязку дома (architecture.md §7.1).
# Внимание: после создания бота ник в MAX изменить нельзя.
MAX_BOT_USERNAME=
# Публичный HTTPS-адрес сервиса: используется в deep-link и в адресе вебхука.
PUBLIC_BASE_URL=
# Базовый адрес MAX Bot API. Подтверждено MAX-001 (max_api.md §2) — можно
# оставить пустым, тогда используется значение по умолчанию ниже.
MAX_API_BASE_URL=https://platform-api2.max.ru

# --- Хранилища ---------------------------------------------------------------
# Порты на хосте — нестандартные, чтобы не конфликтовать с локально
# установленными PostgreSQL/Qdrant. Внутри docker-сети контейнеры слушают
# стандартные порты (5432, 6333) — эти значения ниже использует контейнер
# app при полном "docker compose up" (см. compose.yaml, там они заданы явно
# для сервиса app и не читаются из .env).
#
# DATABASE_URL и QDRANT_URL в этом файле — для локального запуска приложения
# через venv на хосте (architecture.md — дев-воркфлоу): оно идёт на localhost
# через порты, пробитые наружу из контейнеров ниже. Если меняете порт —
# меняйте его в обеих строках (POSTGRES_PORT и DATABASE_URL; QDRANT_PORT и
# QDRANT_URL), автоподстановки между строками .env не происходит.
POSTGRES_PORT=55432
QDRANT_PORT=56333
DATABASE_URL=postgresql+asyncpg://upravdom:upravdom@localhost:55432/upravdom
QDRANT_URL=http://localhost:56333

# --- LLM (OpenRouter) ------------------------------------------------------
OPENROUTER_API_KEY=
# Модель не хардкодится в коде — задаётся здесь.
# Выбор — замер CLASSIFY-003 (scripts/model_bakeoff.py), обоснование —
# documentation/openrouter_api.md §10.
OPENROUTER_MODEL=nex-agi/nex-n2.5-pro:free
# Резерв — у другого провайдера: модели одного провайдера отказывают
# одновременно, и резерв из того же семейства не спасает (§10).
OPENROUTER_MODEL_FALLBACK=nvidia/nemotron-3-super-120b-a12b:free
# Таймаут одного запроса (подключение отдельно 3 с). Основная + резерв =
# 2×45 = 90 с — меньше окна видимости inbound (120 с), повторной обработки нет.
LLM_TIMEOUT_SECONDS=45
# Прокси только для вызовов OpenRouter (http://user:pass@host:port). Нужен,
# если openrouter.ai недоступен с адреса сервера; локально обычно пусто.
# MAX API и Qdrant через него не ходят. Содержит пароль — секрет.
LLM_PROXY=
# Локальный лимит исходящих вызовов (ниже платформенных ~20 RPM на :free).
LLM_MAX_REQUESTS_PER_MINUTE=15
LLM_CIRCUIT_FAILURE_THRESHOLD=3
LLM_CIRCUIT_OPEN_SECONDS=60

# --- Эмбеддинги --------------------------------------------------------------
EMBEDDING_MODEL_NAME=sergeyzh/BERTA

# --- Пороги классификации (architecture.md §4) -----------------------------
# >= HIGH        — заявка создаётся и маршрутизируется автоматически
# LOW..HIGH      — один уточняющий вопрос жителю
# < LOW          — честное «не берусь определить» + зона unknown
CLASSIFY_CONFIDENCE_HIGH=0.75
CLASSIFY_CONFIDENCE_LOW=0.45
# Порог семантического кэша: не «похоже», а «то же самое» (architecture.md §6.2).
SEMANTIC_CACHE_THRESHOLD=0.92
# Часовой пояс для срока заявки в ответах жителю (FLOW-001).
DISPLAY_TIMEZONE=Europe/Moscow

# --- Уведомления об отключениях (architecture.md §5.3, NOTIFY-001) ---------
# Как часто задача планировщика ищет, кому ещё не отправлено.
NOTIFY_POLL_INTERVAL_SECONDS=60
# Сколько доставок за один проход: большой дом не должен занять воркер целиком.
NOTIFY_BATCH_SIZE=200

# --- Дедупликация массовых обращений (architecture.md §6.5, DEDUP-001) -----
# Окно склейки: за его пределами это уже новая авария, даже если
# формулировка совпала.
DEDUP_WINDOW_HOURS=6
# Порог косинусной похожести описаний. Откалиброван на
# data/test_cases/dedup_cases.json (scripts/run_dedup_check.py): ноль ложных
# склеек и 88% почти дословных повторов соседей. Значение 0.88 из
# architecture.md §6.5 было допущением — на BERTA оно не склеивает ничего.
DEDUP_SIMILARITY_THRESHOLD=0.80

# --- Персональные данные (architecture.md §11) -----------------------------
# Версия текста согласия на обработку ПДн. При изменении текста версия
# повышается, и согласие запрашивается повторно.
CONSENT_VERSION=1
# Публичный адрес политики обработки персональных данных, показывается
# жителю на шаге согласия.
PRIVACY_POLICY_URL=
# Общий контакт, если дом жителя ещё не подключён к боту (ONBOARD-002).
FALLBACK_CONTACT_TEXT=При аварии, опасной для жизни, звоните 112. По остальным вопросам обратитесь в свою управляющую компанию — контакты обычно есть на квитанции.

# --- Ограничение частоты запросов (architecture.md §10) --------------------
RATE_LIMIT_MESSAGES_PER_MINUTE=10

# --- Воркер inbox/outbox (BOT-001, architecture.md §3, §7) -----------------
WORKER_POLL_INTERVAL_SECONDS=1.0
WORKER_BATCH_SIZE=10
# Событие, зависшее в processing дольше этого времени, считается упавшим
# воркером и возвращается в очередь (или уходит в failed, если исчерпаны
# попытки) — architecture.md §3.
INBOUND_VISIBILITY_TIMEOUT_SECONDS=120
INBOUND_MAX_ATTEMPTS=5
OUTBOUND_MAX_ATTEMPTS=5
OUTBOUND_BACKOFF_BASE_SECONDS=2.0
